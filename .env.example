# Supabase — copie para .env.local e preencha com os valores do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usado apenas em rotas de servidor confiáveis (painel super_admin e
# adicionar RTVs à equipe). NUNCA exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Assistente de IA (opcional). Sem esta chave, o botão de IA avisa que
# precisa ser configurado. Modelo padrão: claude-opus-5.
ANTHROPIC_API_KEY=sua-anthropic-api-key
# Opcional — troque para um modelo mais barato se quiser (ex.: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-opus-5
