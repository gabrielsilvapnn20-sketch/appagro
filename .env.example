# Supabase — copie para .env.local e preencha com os valores do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usado apenas em rotas de servidor confiáveis (painel super_admin e
# adicionar RTVs à equipe). NUNCA exponha ao browser.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Assistente de IA (opcional). Sem esta chave, o botão de IA avisa que
# precisa ser configurado. Modelo padrão: claude-opus-5.
ANTHROPIC_API_KEY=sua-anthropic-api-key
# Opcional — troque para um modelo mais barato se quiser (ex.: claude-haiku-4-5)
# ANTHROPIC_MODEL=claude-opus-5

# Satélite (opcional). Instance ID de uma configuração WMS/OGC do Sentinel Hub
# (Configuration Utility → sua instância). NÃO são os IDs de coleção — é o ID
# da instância OGC. Sem isto, o talhão apenas não mostra as imagens.
NEXT_PUBLIC_SENTINEL_INSTANCE_ID=

# Web Push — lembretes de retorno com o app fechado (opcional).
# Gere um par de chaves VAPID com:  npx web-push generate-vapid-keys
# A chave PÚBLICA vai nas duas variáveis abaixo (browser + função agendada);
# a PRIVADA fica só no servidor. Sem isto, as notificações ainda funcionam
# com o app aberto, só não são enviadas com ele fechado.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional — contato do remetente exigido pelo padrão Web Push.
VAPID_SUBJECT=mailto:contato@agrogiro.app
